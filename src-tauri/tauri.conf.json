{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DewClip",
  "version": "1.0.0",
  "identifier": "io.github.rexkev214.dewclip",
  "plugins": {},
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [
      {
        "title": "DewClip",
        "label": "main",
        "width": 372,
        "height": 600,
        "minWidth": 300,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": false,
        "decorations": false,
        "devtools": false,
        "skipTaskbar": true,
        "visible": true,
        "visibleOnAllWorkspaces": true,
        "dragDropEnabled": false,
        "acceptFirstMouse": true,
        "focusable": true,
        "theme": "Light"
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "$HOME/**",
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$PROFILE/**"
        ]
      },
      "capabilities": [
        {
          "identifier": "main-capability",
          "description": "Main window capabilities",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-start-dragging",
            "core:window:allow-hide",
            "core:window:allow-show",
            "core:window:allow-close",
            "core:window:allow-set-focus",
            "core:window:allow-is-visible",
            "core:window:allow-inner-size",
            "core:window:allow-inner-position",
            "core:window:allow-scale-factor",
            "core:window:allow-set-size",
            "core:window:allow-set-position",
            "core:window:allow-set-always-on-top",
            "core:window:allow-set-visible-on-all-workspaces",
            "core:window:allow-current-monitor",
            "core:window:allow-cursor-position",
            "core:window:allow-create",
            "core:window:allow-get-all-windows",
            "core:webview:allow-create-webview-window",
            "core:window:allow-set-ignore-cursor-events",
            "core:window:allow-set-focusable",
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "core:event:allow-emit",
            "core:app:allow-version",
            "core:app:default",
            "dialog:allow-open",
            "dialog:allow-save",
            "dialog:default",
            {
              "identifier": "core:path:default",
              "allow": [
                {
                  "path": "$HOME/**"
                },
                {
                  "path": "$APPDATA/**"
                },
                {
                  "path": "$APPLOCALDATA/**"
                },
                {
                  "path": "$PROFILE/**"
                }
              ]
            },
            "opener:allow-reveal-item-in-dir",
            {
              "identifier": "opener:allow-open-url",
              "allow": [
                {
                  "url": "https://**"
                }
              ]
            }
          ]
        },
        {
          "identifier": "capsule-capability",
          "description": "The copy capsule only listens for its events",
          "windows": [
            "capsule"
          ],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright © 2026 REXKEV214. Licensed under GPL-3.0.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/app.icns"
    ],
    "targets": [
      "dmg",
      "app"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
